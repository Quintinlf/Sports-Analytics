# Sports Analytics Platform — Environment Configuration

# Core Database
# Local dev:
DATABASE_URL=sqlite:///./sports_analytics.db
# Render PostgreSQL (from Render dashboard → your database → Connections):
# DATABASE_URL=postgresql://user:pass@host:port/dbname
# Supabase Session Pooler (recommended for FastAPI):
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require

# Migration source (one-time SQLite -> Postgres)
SQLITE_DATABASE_URL=sqlite:///./sports_analytics.db

# Public app URL (no trailing slash)
# Local:
# FEEDBACK_BASE_URL=http://localhost:8000
# Render:
FEEDBACK_BASE_URL=https://your-service.onrender.com

# Browser origins allowed to call the API (comma-separated). Optional.
# When unset, localhost:8000 / 127.0.0.1:8000 + FEEDBACK_BASE_URL are used.
# CORS_ALLOWED_ORIGINS=https://your-service.onrender.com,http://localhost:8000

# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
FEEDBACK_EMAIL_FROM=your-email@gmail.com

# Weekly email test mode (comma-separated; when set, only these addresses receive mail)
WEEKLY_EMAIL_ALLOWLIST=quintinlf7@gmail.com

# Deployment validation
TEST_REVIEWER_ID=quintin
TEST_FAVORITE_SPORT=MLB

# Optional
ERROR_NOTIFY_EMAIL=devops@example.com
TEST_EMAIL=quintinlf7@gmail.com

# Dashboard prediction limits per sport (default 6 each)
# DASHBOARD_PRED_LIMIT_MLB=6
# DASHBOARD_PRED_LIMIT_NBA=6
# DASHBOARD_PRED_LIMIT_FIFA=6

# Dev-only: seed synthetic demo predictions (Yankees/Lakers/Man City, etc.)
# and FIFA's fabricated off-season fixtures into the predictions table.
# Leave unset in production — real deployments should only ever show live
# model output.
# ENABLE_DEMO_PREDICTIONS=true
